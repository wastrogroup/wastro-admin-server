NODE_ENV=development
PORT=4000

# Local PostgreSQL (pgAdmin) — create DB/user to match these values
DATABASE_URL=postgresql://wastro:wastro@localhost:5432/wastro_admin

CLIENT_ORIGIN=http://localhost:5173
SESSION_SECRET=replace-with-a-long-random-secret-at-least-32-chars
COOKIE_SECURE=false
SESSION_IDLE_MS=1800000
SESSION_ABSOLUTE_MS=43200000

# Used only by: npm run seed:admin
ADMIN_BOOTSTRAP_NAME=Super Admin
ADMIN_BOOTSTRAP_EMAIL=admin@wastro.local
ADMIN_BOOTSTRAP_PASSWORD=replace-with-a-strong-password
